{
  "uid": "shop-mesh",
  "title": "shop: mesh и канареечный релиз",
  "tags": [
    "shop",
    "linkerd",
    "lab6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Shop alerts firing",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"Shop.*\", alertstate=\"firing\"}",
        "step": "15s",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Надёжность: backend фейлит, клиент не видит",
      "description": "Часть 4. Доля ответов-ошибок api по метрикам inbound-прокси (что реально вернул backend), доля ошибок у клиента loadgen (что увидел пользователь) и доля запросов, ушедших на ретрай в прокси клиента.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\", classification=\"failure\"}[1m])) / sum(rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\"}[1m]))",
          "legendFormat": "backend: ошибки api (inbound proxy)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loadgen_requests_total{namespace=\"shop\", result!=\"ok\"}[1m])) / sum(rate(loadgen_requests_total{namespace=\"shop\"}[1m]))",
          "legendFormat": "клиент: ошибки loadgen"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(outbound_http_route_retry_requests_total{namespace=\"shop\", parent_name=\"shop-api\"}[1m])) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\", parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "ретраи / запросы клиента"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ретраи mesh, шт/с",
      "description": "Счётчики ретраев HTTPRoute в прокси клиента: сколько попыток повторено, сколько повторов закончились успехом, сколько упёрлись в limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(outbound_http_route_retry_requests_total{namespace=\"shop\", parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "повторы"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(outbound_http_route_retry_successes_total{namespace=\"shop\", parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "успешные повторы"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(outbound_http_route_retry_limit_exceeded_total{namespace=\"shop\", parent_name=\"shop-api\"}[1m]))",
          "legendFormat": "limit исчерпан"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Деление трафика по версиям",
      "description": "Доля запросов, пришедших на каждую версию api (inbound-прокси, только mTLS-трафик из mesh).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\"}[1m])) / scalar(sum(rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\"}[1m])))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Гейт: вес v2 и решение",
      "description": "Вес v2 в HTTPRoute, который выставил гейт (0–100%), и состояние гейта: 0 — выкатка идёт, 1 — докатил до 100%, 2 — откатил.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(gate_v2_weight{namespace=\"shop\"})",
          "legendFormat": "вес v2, %"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(gate_state{namespace=\"shop\"}) * 50",
          "legendFormat": "состояние гейта ×50 (50 = докатил, 100 = откатил)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Доля ошибок по версиям",
      "description": "classification=failure в inbound-прокси, по версиям. Порог гейта и алерта — 5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\", classification=\"failure\"}[1m])) / sum by (version) (rate(response_total{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Задержка p95 по версиям (сервер, inbound-прокси)",
      "description": "p95 response_latency_ms на inbound-прокси api. Порог гейта — 300 мс.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (version, le) (rate(response_latency_ms_bucket{namespace=\"shop\", app=\"api\", direction=\"inbound\", tls=\"true\"}[1m])))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Задержка глазами клиента (loadgen)",
      "description": "POST /order, только 2xx. Сравнение baseline и mesh — Часть 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loadgen_request_duration_seconds_bucket{namespace=\"shop\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loadgen_request_duration_seconds_bucket{namespace=\"shop\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loadgen_request_duration_seconds_bucket{namespace=\"shop\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU подов api: приложение и прокси",
      "description": "Цена mesh в ресурсах: CPU контейнеров api и linkerd-proxy (сумма по подам). Часть 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"shop\", pod=~\"shop-api-.*\", container!=\"\", container!=\"POD\"}[2m]))",
          "legendFormat": "{{container}}"
        }
      ]
    }
  ]
}